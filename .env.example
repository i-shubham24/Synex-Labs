# Public, client-safe values only. Never put secrets here.
# Canonical site URL used for metadata, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=https://synex-labs.pages.dev

# --- Server-only. Contact form email through Resend (resend.com). Without these the form opens the visitor's mail app instead. ---
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL="Synex Labs <hello@your-own-domain>"   # needs a domain you own, verified in Resend

# Shared rate limit across server instances (Upstash Redis REST).
# Without these the limit is kept in memory per instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Google Search Console HTML tag verification (the content="" value only).
# GOOGLE_SITE_VERIFICATION=

# WhatsApp chat button (digits with country code). Defaults to the studio number in src/lib/contact.ts.
# NEXT_PUBLIC_WHATSAPP_NUMBER=917973373923
# Optional "Book a call" button
# NEXT_PUBLIC_BOOKING_URL=
